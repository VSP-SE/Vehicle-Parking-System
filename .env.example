# Replace this placeholder with a generated secret key. Required for Django.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
# Local development only; production should use False.
DJANGO_DEBUG=True
# Comma-separated hostnames, without schemes or ports.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 16 database and credentials. Create this database and user locally.
POSTGRES_DB=vps
POSTGRES_USER=vps
POSTGRES_PASSWORD=replace-with-your-local-database-password
# localhost is for Django on the host; Compose overrides this to db for web.
POSTGRES_HOST=localhost
# Compose publishes this host port; web always connects to db on port 5432.
POSTGRES_PORT=5432

# SMTP server and credentials. Replace with your provider's values.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=True

# Optional: set to 1 to run tests with SQLite instead of PostgreSQL.
VPS_TEST_SQLITE=0
